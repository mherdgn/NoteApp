
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NoteApp</title>

    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            transition: background-color 0.3s, color 0.3s;
            background-color: #f8f9fa;
            color: #212529;
        }

            body.dark-mode {
                background-color: #1a1a1a;
                color: #f0f0f0;
            }

        .navbar {
            transition: all 0.3s;
        }

        body.dark-mode .navbar {
            background-color: #212121 !important;
        }

            body.dark-mode .navbar .nav-link,
            body.dark-mode .navbar .navbar-brand {
                color: #f0f0f0 !important;
            }

                body.dark-mode .navbar .nav-link:hover {
                    color: #ffffff !important;
                }

        .card {
            transition: 0.3s;
        }

        body.dark-mode .card {
            background-color: #2a2a2a;
            color: #f0f0f0;
        }

        body.dark-mode .pagination .page-link {
            background-color: #2c2c2c;
            color: #f0f0f0;
            border-color: #444;
        }

        body.dark-mode .pagination .page-item.active .page-link {
            background-color: #6c757d;
            border-color: #6c757d;
        }

        .theme-toggle-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid #6c757d;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.3s;
        }

            .theme-toggle-btn:hover {
                background-color: #6c757d;
                color: #fff;
            }

        footer {
            font-size: 14px;
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">

            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Notes"
                   asp-action="Index">
                    📝 NoteApp
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">

                    <!-- SOL MENÜ -->
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Notes"
                               asp-action="Index">
                                🏠 Notlar
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Notes"
                               asp-action="Create">
                                Yeni Not
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Notes"
                               asp-action="Favorites">
                                ⭐ Favoriler
                            </a>
                        </li>

                    </ul>

                    <!-- SAĞ MENÜ -->
                    <div class="d-flex align-items-center gap-3">

                        @if (Context.Session.GetString("Username") != null)
                        {
                            <span class="fw-semibold">
                                👤 @Context.Session.GetString("Username")
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Çıkış Yap
                                </button>

                            </form>
                        }

                        <button class="theme-toggle-btn"
                                id="toggleTheme"
                                type="button">

                            <span id="themeIcon">🌙</span>

                        </button>

                    </div>

                </div>

            </div>

        </nav>
    </header>

    <!-- SAYFA İÇERİĞİ -->
    <main role="main" class="flex-grow-1">

        <div class="container py-4">
            @RenderBody()
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="bg-dark text-white text-center py-3 mt-auto">

        <div class="container">
            <p class="mb-0">© 2025 NoteApp - Tüm Hakları Saklıdır</p>
        </div>

    </footer>

    <!-- JAVASCRIPT KÜTÜPHANELERİ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- TEMA DEĞİŞTİRME -->
    <script>

        const btn = document.getElementById("toggleTheme");
        const icon = document.getElementById("themeIcon");
        const body = document.body;

        if (localStorage.getItem("theme") === "dark") {
            body.classList.add("dark-mode");
            icon.textContent = "☀️";
        }

        btn.addEventListener("click", () => {

            body.classList.toggle("dark-mode");

            if (body.classList.contains("dark-mode")) {

                localStorage.setItem("theme", "dark");
                icon.textContent = "☀️";

            } else {

                localStorage.setItem("theme", "light");
                icon.textContent = "🌙";

            }

        });

    </script>

    <!-- SAYFAYA AİT JAVASCRIPT KODLARI -->
    @RenderSection("Scripts", required: false)

    <!-- BİLDİRİMLER -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="successToast"
                 class="toast text-bg-success border-0"
                 role="alert">

                <div class="d-flex">

                    <div class="toast-body">
                        @TempData["SuccessMessage"]
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast">
                    </button>

                </div>

            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div id="errorToast"
                 class="toast text-bg-danger border-0"
                 role="alert">

                <div class="d-flex">

                    <div class="toast-body">
                        @TempData["ErrorMessage"]
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast">
                    </button>

                </div>

            </div>
        }

    </div>

    <!-- BİLDİRİMLERİ OTOMATİK KAPAT -->
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const toastIds = ["successToast", "errorToast"];

            toastIds.forEach(id => {

                const toastElement = document.getElementById(id);

                if (toastElement) {

                    const toast = new bootstrap.Toast(toastElement, {
                        autohide: true,
                        delay: 3000
                    });

                    toast.show();

                }

            });

        });

    </script>

</body>
</html>
