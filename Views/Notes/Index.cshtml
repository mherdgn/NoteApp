@model IEnumerable<NoteApp.Models.Note>

@{
    ViewData["Title"] = "Notlar";
    string searchString = ViewData["SearchString"] as string;
    int currentPage = ViewData["CurrentPage"] != null ? (int)ViewData["CurrentPage"] : 1;
    int totalPages = ViewData["TotalPages"] != null ? (int)ViewData["TotalPages"] : 1;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

@Html.AntiForgeryToken()

<h2 class="mb-4">📝 Notlar</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ARAMA -->
<form method="get" class="mb-4 d-flex gap-2">
    <input type="text"
           name="searchString"
           value="@searchString"
           class="form-control search-input"
           placeholder="🔍 Notlarda ara..." />

    <button class="btn btn-primary">Ara</button>
</form>

<!-- YENİ NOT -->
<a asp-action="Create" class="btn btn-success mb-4">Yeni Not</a>

<!-- NOTLAR -->
<div class="row g-4">

    @foreach (var note in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">

            <div class="card note-card">

                <div class="card-body d-flex flex-column">

                    <!-- BAŞLIK VE FAVORİ -->
                    <div class="d-flex justify-content-between align-items-start mb-2">

                        <h5 class="card-title mb-0">
                            @note.Title
                        </h5>

                        <button type="button"
                                class="fav-btn"
                                data-id="@note.Id">

                            <i class="@(note.IsFavorite
                                                               ? "fa-solid fa-heart text-danger"
                                                               : "fa-regular fa-heart")"></i>

                    </button>

                    </div>

                    <!-- İÇERİK -->
                    <div class="card-text note-content mb-3">
                        @Html.Raw(note.Content ?? "")
                    </div>

                    <!-- İŞLEMLER -->
                    <div class="mt-auto d-flex gap-1">

                        <a asp-action="Details"
                           asp-route-id="@note.Id"
                           class="btn btn-sm btn-info">
                            Detay
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@note.Id"
                           class="btn btn-sm btn-warning">
                            Düzenle
                        </a>

                        <form asp-action="Delete" method="post" class="d-inline">

                            <input type="hidden" name="id" value="@note.Id" />

                            <button type="submit" class="btn btn-sm btn-danger">
                                Sil
                            </button>

                        </form>

                    </div>

                </div>

                <!-- TARİH -->
                <div class="card-footer text-muted">
                    <small>
                        @note.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>

            </div>

        </div>
        }

</div>

<!-- SAYFALAMA -->
@if (totalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-searchString="@searchString">
                    Önceki
                </a>

            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@searchString">
                        @i
                    </a>

                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-searchString="@searchString">
                    Sonraki
                </a>

            </li>

        </ul>

    </nav>
}

<style>

    /* KART */
    .note-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: var(--card);
        color: var(--text);
        border-radius: 12px;
        border: none;
        transition: 0.3s;
    }

        .note-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

    /* NOT İÇERİĞİ */
    .note-content {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow-wrap: anywhere;
    }

    /* ARAMA */
    .search-input {
        background: var(--card);
        color: var(--text);
        border: none;
    }

    /* FAVORİ */
    .fav-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
    }

        .fav-btn i {
            transition: transform 0.2s;
        }

        .fav-btn:hover i {
            transform: scale(1.2);
        }

    /* ALT BİLGİ */
    .note-card .card-footer {
        background: transparent;
    }

</style>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // BAŞARI MESAJINI 3 SANİYE SONRA KAPAT
            const successAlert = document.getElementById("successAlert");

            if (successAlert) {

                setTimeout(function () {

                    successAlert.classList.remove("show");

                    setTimeout(function () {
                        successAlert.remove();
                    }, 500);

                }, 3000);

            }

            // FAVORİ İŞLEMİ
            document.querySelectorAll(".fav-btn").forEach(btn => {

                btn.addEventListener("click", async () => {

                    const id = btn.dataset.id;

                    const token = document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value;

                    try {

                        const res = await fetch(`/Notes/ToggleFavorite?id=${id}`, {

                            method: "POST",

                            headers: {
                                "RequestVerificationToken": token
                            }

                        });

                        if (!res.ok) {

                            alert("Favori işlemi başarısız. Hata: " + res.status);
                            return;

                        }

                        const isFav = await res.json();

                        const icon = btn.querySelector("i");

                        icon.className = "";

                        if (isFav) {

                            icon.classList.add(
                                "fa-solid",
                                "fa-heart",
                                "text-danger"
                            );

                        } else {

                            icon.classList.add(
                                "fa-regular",
                                "fa-heart"
                            );

                        }

                        icon.style.transform = "scale(1.3)";

                        setTimeout(() => {
                            icon.style.transform = "scale(1)";
                        }, 150);

                    } catch (error) {

                        alert("Bir bağlantı hatası oluştu.");
                        console.error(error);

                    }

                });

            });

        });

    </script>

}
