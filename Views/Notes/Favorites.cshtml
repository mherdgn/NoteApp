@model List<NoteApp.Models.Note>

@{
    ViewData["Title"] = "Favori Notlar";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container mt-4">

    <h2 class="mb-4">⭐ Favori Notlar</h2>

    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Henüz favori not yok.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card note-card h-100 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @item.Title
                            </h5>

                            <div class="card-text note-content mb-3">
                                @Html.Raw(item.Content ?? "")
                            </div>

                            <div class="mt-auto d-flex gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-info">
                                    <i class="fa-solid fa-eye"></i> Detay
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-warning">
                                    <i class="fa-solid fa-pen"></i> Düzenle
                                </a>

                            </div>

                        </div>

                        <div class="card-footer text-muted">
                            <small>
                                @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

<style>
    .note-card {
        height: 100%;
        background: var(--card);
        color: var(--text);
        border: none;
        border-radius: 12px;
        transition: 0.3s;
    }

    .note-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .note-content {
        overflow-wrap: anywhere;
        max-height: 180px;
        overflow: hidden;
    }

    .note-card .card-footer {
        background: transparent;
    }
</style>
